did-document = {
    "service" = serviceEndpoint

}

serviceEndpoint = {
    ? "@content" : ~uri
    "id" : did-url
    "type" : text 
    ? "description" : text 
    "serviceEndpoint" : ~uri 
}


did-url = text .regexp "did:[a-z0-9]+:[A-Za-z0-9\\.\\-:_]+/?[A-Za-z0-9/]+\\??([A-Za-z0-9=&%\\-:]+)?#?([A-Za-z0-9\\-_]+)?"







